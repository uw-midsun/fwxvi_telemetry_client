          "label": "Thermistor 1",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_2",
          "label": "Thermistor 2",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_3",
          "label": "Thermistor 3",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_4",
          "label": "Thermistor 4",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_5",
          "label": "Thermistor 5",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_6",
          "label": "Thermistor 6",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_7",
          "label": "Thermistor 7",
          "min": 0.0,
