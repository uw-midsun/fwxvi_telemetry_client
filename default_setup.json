          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_9",
          "label": "Thermistor 9",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_10",
          "label": "Thermistor 10",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_11",
          "label": "Thermistor 11",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_12",
          "label": "Thermistor 12",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_13",
          "label": "Thermistor 13",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_14",
          "label": "Thermistor 14",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_15",
          "label": "Thermistor 15",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_16",
          "label": "Thermistor 16",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
          "signal": "AFE_temperature.temperature_17",
          "label": "Thermistor 17 (External)",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        }
      ],
      "width": "full"
    },
    {
      "id": "discharge_bits",
      "title": "Cell Discharge Bits",
      "chart_type": "leds",
      "signals": [
        "AFE_discharge_bitset.cell_0",
        "AFE_discharge_bitset.cell_1",
        "AFE_discharge_bitset.cell_2",
        "AFE_discharge_bitset.cell_3",
        "AFE_discharge_bitset.cell_4",
        "AFE_discharge_bitset.cell_5",
        "AFE_discharge_bitset.cell_6",
        "AFE_discharge_bitset.cell_7",
        "AFE_discharge_bitset.cell_8",
        "AFE_discharge_bitset.cell_9",
        "AFE_discharge_bitset.cell_10",
        "AFE_discharge_bitset.cell_11",
        "AFE_discharge_bitset.cell_12",
        "AFE_discharge_bitset.cell_13",
        "AFE_discharge_bitset.cell_14",
        "AFE_discharge_bitset.cell_15"
      ],
      "width": "medium"
    },
    {
      "id": "velocity_stats",
      "title": "Velocity (window stats)",
      "chart_type": "stat",
      "signals": [
        "ws22_velocity.vehicle_velocity_kph"
      ],
      "width": "medium"
    }
  ]
}
