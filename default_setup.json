{
  "name": "default",
  "live": true,
  "window_seconds": 30.0,
  "panels": [
    {
      "id": "velocity",
      "title": "Vehicle Velocity (kph)",
      "chart_type": "line",
      "signals": [
        "ws22_velocity.vehicle_velocity_kph",
        "ws22_velocity.motor_velocity_rpm"
      ],
      "y_range": [
        0.0,
        80.0
      ],
      "width": "wide"
    },
    {
      "id": "vitals",
      "title": "Vitals",
      "chart_type": "meters",
      "signals": [],
      "fields": [
        {
          "signal": "ws22_temp.motor_temp",
          "label": "Motor Temp",
          "min": 0.0,
          "max": 120.0,
          "unit": "C"
        },
        {
          "signal": "ws22_temp.heatsink_temp",
          "label": "Heatsink Temp",
          "min": 0.0,
          "max": 100.0,
          "unit": "C"
        },
        {
          "signal": "battery_stats_A.pack_soc",
          "label": "State of Charge",
          "min": 0.0,
          "max": 100.0,
          "unit": "%"
        }
      ],
      "width": "small"
    },
    {
      "id": "vc_recap",
      "title": "Voltage / Current Recap",
      "chart_type": "matrix",
      "width": "wide",
      "columns": ["Pack", "Motor", "PCS", "Aux"],
      "rows": [
        {
          "label": "Voltage",
          "cells": [
            { "signal": "battery_stats_A.pack_voltage_v",       "unit": "V" },
            { "signal": "ws22_bus.bus_voltage_cv",              "unit": "V" },
            { "signal": "power_input_stats.input_dcdc_voltage", "unit": "V" },
            { "signal": "power_input_stats.input_aux_voltage",  "unit": "V" }
          ]
        },
        {
          "label": "Current",
          "cells": [
            { "signal": "battery_stats_B.pack_current_a",       "unit": "A" },
            { "signal": "ws22_bus.bus_current_ca",              "unit": "A" },
            { "signal": "power_input_stats.input_dcdc_current", "unit": "mA" },
            { "signal": "power_input_stats.input_aux_current",  "unit": "mA" }
          ]
        }
      ]
    },
    {
      "id": "pack_voltage",
      "title": "Pack Voltage",
      "chart_type": "line",
      "signals": [
        "battery_stats_A.pack_voltage_v"
      ],
      "colors": ["red"],
      "y_range": [
        0.0,
        200.0
      ],
      "width": "medium"
    },
    {
      "id": "pack_current",
      "title": "Pack Current",
      "chart_type": "line",
      "signals": [
        "battery_stats_B.pack_current_a"
      ],
      "colors": ["blue"],
      "y_range": [
        0.0,
        75.0
      ],
      "width": "medium"
    },
    {
      "id": "bus_voltage",
      "title": "Motor Bus Voltage (V)",
      "chart_type": "line",
      "signals": [
        "ws22_bus.bus_voltage_cv"
      ],
      "colors": ["red"],
      "y_range": [
        0.0,
        200.0
      ],
      "width": "medium"
    },
    {
      "id": "bus_current",
      "title": "Motor Bus Current (A)",
      "chart_type": "line",
      "signals": [
        "ws22_bus.bus_current_ca"
      ],
      "colors": ["blue"],
      "y_range": [
        0.0,
        200.0
      ],
      "width": "medium"
    },
    {
      "id": "input_voltages",
      "title": "PCS / Aux Voltage (V)",
      "chart_type": "line",
      "signals": [
        "power_input_stats.input_dcdc_voltage",
        "power_input_stats.input_aux_voltage"
      ],
      "colors": ["red", "orange"],
      "y_range": [
        0.0,
        20.0
      ],
      "width": "medium"
    },
    {
      "id": "input_currents",
      "title": "PCS / Aux Current (mA)",
      "chart_type": "line",
      "signals": [
        "power_input_stats.input_dcdc_current",
        "power_input_stats.input_aux_current"
      ],
      "colors": ["blue", "green"],
      "y_range": [
        0.0,
        10.0
      ],
      "width": "medium"
    },
    {
      "id": "pedals",
      "title": "Pedals",
      "chart_type": "pedals",
      "signals": [
        "drive_status.pedal_percentage",
        "drive_status.brake_percentage",
        "drive_status.drive_state"
      ],
      "gauge": {
        "min": 0.0,
        "max": 100.0,
        "unit": "%"
      },
      "width": "small"
    },
    {
      "id": "vehicle_status",
      "title": "Vehicle Status",
      "chart_type": "status",
      "signals": [
        "drive_status.drive_state",
        "rear_controller_status.bps_fault",
        "bps_fault_info.fault_cell_index",
        "bps_fault_info.fault_cell_voltage",
        "bps_fault_info.fault_temperature_c",
        "bps_fault_info.fault_current_a",
        "bps_fault_info.fault_max_cell_index",
        "bps_fault_info.fault_min_cell_index",
        "bps_fault_info.fault_max_cell_voltage",
        "bps_fault_info.fault_min_cell_voltage",
        "ws22_status.error_flags",
        "ws22_status.limit_flags"
      ],
      "width": "wide"
    },
    {
      "id": "cell_voltage",
      "title": "Cell Voltage (max / min)",
      "chart_type": "line",
      "signals": [
        "battery_stats_B.max_cell_voltage",
        "battery_stats_B.min_cell_voltage"
      ],
      "colors": ["red", "orange"],
      "y_range": [
        2.0,
        5.0
      ],
      "width": "small"
    },
    {
      "id": "accessory_currents",
      "title": "Accessory Currents",
      "chart_type": "meters",
      "signals": [],
      "fields": [
        {
          "signal": "fc_power_group_A.rev_cam_current",
          "label": "Rev Cam",
          "min": 0.0,
          "max": 1000.0,
          "unit": "mA"
        },
        {
          "signal": "fc_power_group_A.telem_current",
          "label": "Telemetry",
          "min": 0.0,
          "max": 1000.0,
          "unit": "mA"
        },
        {
          "signal": "fc_power_group_A.steering_current",
          "label": "Steering",
          "min": 0.0,
          "max": 1000.0,
          "unit": "mA"
        },
        {
          "signal": "fc_power_group_A.driver_fan_current",
          "label": "Driver Fan",
          "min": 0.0,
          "max": 1000.0,
          "unit": "mA"
        },
        {
          "signal": "fc_power_group_B.horn_current",
          "label": "Horn",
          "min": 0.0,
          "max": 1000.0,
          "unit": "mA"
        },
        {
          "signal": "fc_power_group_B.spare_current",
          "label": "Spare",
          "min": 0.0,
          "max": 1000.0,
          "unit": "mA"
        }
      ],
      "width": "medium"
    },
    {
      "id": "thermistors",
      "title": "Thermistors",
      "chart_type": "meters",
      "signals": [],
      "fields": [
        {
          "signal": "AFE_temperature.temperature_0",
          "label": "Thermistor 0",
          "min": 0.0,
          "max": 80.0,
          "unit": "C"
        },
        {
